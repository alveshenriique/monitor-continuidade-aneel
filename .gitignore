# Dados brutos da ANEEL (grandes — nunca versionar; só o seed pequeno entra)
data/raw/
*.parquet
*.zip
*.csv

# Bancos locais
*.duckdb
*.db

# Seed pequeno e pré-processado (permite `docker compose up` funcionar de
# primeira, sem baixar/reprocessar o dado bruto). Precisa vir DEPOIS das
# regras acima — o gitignore aplica a última regra que casar com o caminho.
!data/seed/**

# Python
.venv/
__pycache__/
*.pyc
.env

# Node
node_modules/
dist/
dist-ssr/
build/
*.tsbuildinfo
.env.local
*.local
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# SO / editor
.DS_Store
Thumbs.db
.idea/
**/.vscode/*
!**/.vscode/extensions.json
*.suo
